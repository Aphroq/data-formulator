  {
    "type": "function",
    "function": {
      "name": "query_trustgraph_rows",
      "description": "Run an explicit read-only GraphQL query against structured rows in the server-bound TrustGraph collection.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32000,
            "description": "An explicit GraphQL query. This tool does not materialize or synchronize a Data Formulator table."
          },
          "variables": {
            "type": "object",
            "description": "Optional GraphQL variable values."
          },
          "operation_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Optional operation name for a multi-operation GraphQL document."
          }
        },
        "required": ["query"],
        "additionalProperties": false
      }
    }
  },
